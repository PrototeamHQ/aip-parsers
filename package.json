{
  "name": "aip-parsers",
  "version": "1.0.0",
  "description": "Independent TypeScript implementation of Google's AIP-160 filtering and AIP-132 order_by: parser, checker, printer and evaluator.",
  "keywords": [
    "aip",
    "aip-160",
    "aip-132",
    "filter",
    "order-by",
    "parser"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrototeamHQ/aip-parsers.git"
  },
  "homepage": "https://github.com/PrototeamHQ/aip-parsers#readme",
  "bugs": "https://github.com/PrototeamHQ/aip-parsers/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.12.1",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./filter": {
      "types": "./dist/filter/index.d.ts",
      "import": "./dist/filter/index.js"
    },
    "./order-by": {
      "types": "./dist/order-by/index.d.ts",
      "import": "./dist/order-by/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown --config-loader native",
    "size": "node scripts/size.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
